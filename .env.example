# Spotify app credentials (https://developer.spotify.com/dashboard).
# Uses the Authorization Code + PKCE flow, so no client secret is needed.
# The redirect URI must be registered in your Spotify app and end in /spotify.
NUXT_PUBLIC_SPOTIFY_CLIENT_ID=
NUXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/spotify

# Google Analytics 4 measurement ID. Leave empty to disable analytics.
NUXT_PUBLIC_GTAG_ID=
