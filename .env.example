# Spotify app credentials — create your OWN app at
# https://developer.spotify.com/dashboard (you can't reuse someone else's).
# Uses the Authorization Code + PKCE flow, so no client secret is needed.
#
# Register the redirect URI below in your app's settings *exactly*, and note:
# Spotify no longer accepts http://localhost — for local dev you must use the
# loopback IP 127.0.0.1 (and open the app at http://127.0.0.1:3000, not localhost).
NUXT_PUBLIC_SPOTIFY_CLIENT_ID=
NUXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/spotify

# Google Analytics 4 measurement ID. Leave empty to disable analytics.
NUXT_PUBLIC_GTAG_ID=

# Server-only secret for the score leaderboard's dedup HMAC. Generate with
# `openssl rand -hex 32`. Empty disables the /api/score backend (the app then
# uses the built-in seeded percentile table). Requires the server build.
NUXT_SCORE_PEPPER=
